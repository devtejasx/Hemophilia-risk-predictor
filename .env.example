# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Security (REQUIRED — the backend refuses to start without JWT_SECRET_KEY)
# ---------------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Comma-separated exact origins. Never "*" — the API sends credentials.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_PATH=hemophilia.db

# First-run bootstrap admin. Leave blank to skip creating one.
# There is no default account: nothing is seeded unless you set these.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# ML
# ---------------------------------------------------------------------------
# Directory holding versioned model artifacts.
ML_ARTIFACTS_DIR=ml/artifacts
# Which version the API serves. "champ-v1" is the CHAMP-trained model.
# "legacy-synthetic-v0" is preserved for provenance only and was trained on
# fabricated data — see ml/artifacts/legacy-synthetic-v0/PROVENANCE.md.
ML_MODEL_VERSION=champ-v1

# ---------------------------------------------------------------------------
# Frontend (frontend/.env — Vite only exposes VITE_* to the browser)
# ---------------------------------------------------------------------------
# VITE_API_URL=http://localhost:8000/api
