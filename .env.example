# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Security (REQUIRED — the backend refuses to start without JWT_SECRET_KEY)
# ---------------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Comma-separated exact origins. Never "*" — the API sends credentials.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_PATH=hemophilia.db

# First-run bootstrap admin. Leave blank to skip creating one.
# There is no default account: nothing is seeded unless you set these.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# ML
# ---------------------------------------------------------------------------
# Directory holding versioned model artifacts.
ML_ARTIFACTS_DIR=ml/artifacts
# Which prediction mode the API serves when a request does not choose one:
# genomic (MMC2 only), clinical (MMC3 only) or merged (both).
ML_DEFAULT_FEATURE_SET=merged
# Pin one artifact and disable mode routing. Leave EMPTY for normal operation.
# "legacy-synthetic-v0" is preserved for provenance only and was trained on
# fabricated data — see ml/artifacts/legacy-synthetic-v0/PROVENANCE.md; the
# application refuses to serve it.
ML_MODEL_VERSION=

# Dataset locations, used by training and validation only — serving a built
# model does not read the CSVs. All three default to the checkout, so the
# project works after a clone with none of them set. DATA_DIR moves both files
# at once; MMC2_PATH / MMC3_PATH override it individually.
DATA_DIR=ml/data
MMC2_PATH=ml/data/BVTH_VTH-2024-000215-mmc2.csv
MMC3_PATH=ml/data/BVTH_VTH-2024-000215-mmc3.csv

# ---------------------------------------------------------------------------
# Frontend (frontend/.env — Vite only exposes VITE_* to the browser)
# ---------------------------------------------------------------------------
# VITE_API_URL=http://localhost:8000/api
